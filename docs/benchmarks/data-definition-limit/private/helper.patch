+def caller(n):
+ return '#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n'+''.join(f'extern unsigned char entry_{i}[];\n' for i in range(n))+'static unsigned char *entries[]={'+','.join(f'entry_{i}' for i in range(n))+'};\n'+r'''
+int main(void) { for(unsigned i=0;i<sizeof(entries)/sizeof(entries[0]);i++) {
+ unsigned k=i%9,n=0; uint64_t v=0; unsigned char expected[32]={0};
+ if((uintptr_t)entries[i] % (1u<<(k<6?k:6)))return 2;
+ switch(k){
+ case 0:v=(i*37u+19u)&255;n=1;break;
+ case 1:v=(i*257u+123u)&65535;n=2;break;
+ case 2:v=UINT64_C(0x80000000)+i*65539u;n=4;break;
+ case 3:v=UINT64_C(0xfedcba9876000000)+i;n=8;break;
+ case 4:v=UINT64_C(0x3f800000)+i;n=4;break;
+ case 5:v=UINT64_C(0x3ff0000000000000)+i;n=8;break;
+ case 6:n=i%13+1;break;
+ case 7:n=snprintf((char*)expected,sizeof expected,"catalog-%04u",i);break;
+ case 8:v=(uintptr_t)entry_0+i%7;n=8;break;
+ }
+ if(k!=7)for(unsigned j=0;j<n && j<8;j++)expected[j]=(unsigned char)(v>>(8*j));
+ if(memcmp(entries[i],expected,n))return 1;
+ } return 0; }
+'''
+def exercise(compiler,work,run,cc,target,execute=True,qbe=None,before=None):
+ d=Path(work)/'data-definition-limit';d.mkdir(parents=True,exist_ok=True);cc=[str(cc)] if isinstance(cc,(str,Path)) else list(map(str,cc));sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();commands=[]
