+ r['negative_cases']=13
+ if execute and qbe:r['qbe_sha256']=invoke(['python3','-c','import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())',qbe],True).stdout.strip()
