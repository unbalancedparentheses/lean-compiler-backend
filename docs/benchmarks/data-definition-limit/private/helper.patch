+  if n<=4096:
+   texts=[(d/f'{n}-{label}.s').read_bytes() for label,_ in modes];assert texts[0]==texts[1]==texts[2]
+ if execute:
+  src=d/'wrong-last.ssa';original=fixture(4096);needle=f'export data $entry_4095 = align 1 {{ b {(4095*37+19)%256} }}';assert needle in original
+  # Use a valid, same-size initializer mutation rather than changing object layout.
+  src.write_text(original.replace(needle,'export data $entry_4095 = align 1 { b 0 }'));asm=d/'wrong-last.s';exe=d/'wrong-last';invoke([compiler,src,'--target',target,'--optimize','-o',asm]);invoke([*cc,'-O2',d/'caller-4096.c',asm,'-o',exe],True);p=invoke([exe],True,False);assert p.returncode==1;r['controls']['wrong_last']='exit1 detected'
