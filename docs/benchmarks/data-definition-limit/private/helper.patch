+ r=dict(target=target,compiler_identity=invoke([compiler,'--build-identity']).stdout.strip(),compiler_sha256=sha(compiler),helper_sha256=sha(__file__),results=[],controls={},checks_per_backend=6145 if execute else 0,before_equivalence='skipped: no before snapshot' if before is None else 'passed')
