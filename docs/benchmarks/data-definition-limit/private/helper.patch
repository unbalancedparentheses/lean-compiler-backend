+   p=invoke(cmd,label=='qbe',n<=4096 or label=='qbe')
+   if n>4096 and label!='qbe':assert p.returncode!=0 and '4096-data-definition resource limit' in p.stderr;row['backends'].append(dict(mode=label,refused=p.stderr));continue
+   b=dict(mode=label,assembly_sha256=sha(asm),execution='not-run');row['backends'].append(b)
