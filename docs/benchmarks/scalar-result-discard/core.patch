diff --git a/LeanCompilerBackend/Validate.lean b/LeanCompilerBackend/Validate.lean
index e9eb776..3632668 100644
--- a/LeanCompilerBackend/Validate.lean
+++ b/LeanCompilerBackend/Validate.lean
@@ -336,12 +336,16 @@ def effectiveCallSignature (callee : Function) (arguments : Array CallArgument)
   return (callee, arguments)
 
 /-- Internal Apple ARM64 w results clear the upper half of x0, allowing a caller
-    to consume the result as l. Floating/subword/void signatures remain exact. -/
+    to consume the result as l. Used floating/subword/void signatures remain
+    exact; effect-only calls may discard scalar results, never aggregates. -/
 def callResultMatches (callee : Function) (width : Option Width) (floating : Bool)
     (subword : Option Subword) (aggregate : Option String := none) : Bool :=
-  aggregate == callee.resultAggregate && floating == callee.resultFloating && subword == callee.resultSubword &&
-    (width == callee.resultWidth ||
-      (!floating && subword.isNone && aggregate.isNone && callee.resultWidth == some .word && width == some .long))
+  -- An effect-only call may ignore any scalar return register. Aggregate
+  -- returns can require caller-provided storage, so they remain exact.
+  (width.isNone && !floating && subword.isNone && aggregate.isNone && callee.resultAggregate.isNone) ||
+    (aggregate == callee.resultAggregate && floating == callee.resultFloating && subword == callee.resultSubword &&
+      (width == callee.resultWidth ||
+        (!floating && subword.isNone && aggregate.isNone && callee.resultWidth == some .word && width == some .long)))
 
 def validate (program : Program) : Except String Unit := do
   if program.isEmpty then throw "program contains no functions"
diff --git a/Tests.lean b/Tests.lean
index 4472d07..9e74904 100644
--- a/Tests.lean
+++ b/Tests.lean
@@ -28,6 +28,15 @@ private def valueEquals [BEq α] (result : Except ε α) (expected : α) : Bool
   | .error _ => false
 
 def main : IO Unit := do
+  let discardedSource := "data $seen = { l 0 } function d $floating() { @s storel 41, $seen ret d_1.5 } function sb $narrow() { @s %v =l loadl $seen %n =l add %v, 1 storel %n, $seen ret 255 } function $nothing() { @s ret } export function l $discarded() { @s call $floating() call $narrow() call $nothing() %r =l loadl $seen ret %r }"
+  let discarded ← match Parser.parseModule discardedSource >>= SSA.constructModule with
+    | .ok m => pure m
+    | .error e => throw (IO.userError e)
+  require (valueEquals (Semantics.evaluateModule discarded "discarded" #[]) (some 42))
+    "effect-only calls must discard scalar results while preserving effects"
+  let aggregateDiscard := "type :big = { l 4 } function :big $aggregate() { @s %p =l alloc8 32 ret %p } export function $bad() { @s call $aggregate() ret }"
+  require (isFailure (Parser.parseModule aggregateDiscard >>= SSA.constructModule))
+    "effect-only call must not omit aggregate result storage"
   AArch64.Tests.run
   AMD64.Tests.run
   Driver.Tests.run
